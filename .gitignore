# Runtime shop data - real transactions, not source code. Never commit this.
data/

# Runtime config/certs generated on first run - notify_config.json holds the
# real Gmail app password and Twilio auth token in plain text; the .pem
# files are the mobile-scanner's self-signed cert/key. None of these belong
# in git - each install generates its own.
exports/

# Python
__pycache__/
*.pyc
*.pyo

# Packaging output (see README "Packaging as a standalone Windows .exe")
build/
dist/
*.spec

# OS noise
.DS_Store
Thumbs.db
